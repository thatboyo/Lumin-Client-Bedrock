<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rain palette: deep storm slate, mist silver, and cool aqua light. -->
    <Color x:Key="WorldBlack">#FF050A0D</Color>
    <Color x:Key="WorldCharcoal">#FF0B141A</Color>
    <Color x:Key="WorldSmoke">#E6122028</Color>
    <Color x:Key="WorldSilver">#FFB9CED5</Color>
    <Color x:Key="WorldWhite">#FFF0FBFF</Color>
    <Color x:Key="WorldMuted">#FF728C96</Color>
    <Color x:Key="GlassStroke">#2A8EEBFF</Color>
    <Color x:Key="GlassHighlight">#178EEBFF</Color>
    <Color x:Key="AccentBright">#FFE5FAFF</Color>
    <Color x:Key="AccentPrimary">#FF7ADCF2</Color>
    <Color x:Key="AccentHalo">#777ADCF2</Color>
    <Color x:Key="EnabledSurface">#C5162831</Color>
    <Color x:Key="SelectedSurface">#E0182E38</Color>
    <Color x:Key="AtmosphereCore">#387ADCF2</Color>
    <Color x:Key="GlassHoverSurface">#D11B303A</Color>
    <Color x:Key="GlassHoverStroke">#668FEAFF</Color>
    <Color x:Key="StatusAmber">#FFE7BD78</Color>
    <Color x:Key="StatusRed">#FFE68B91</Color>

    <SolidColorBrush x:Key="WorldBlackBrush" Color="{StaticResource WorldBlack}" />
    <SolidColorBrush x:Key="WorldCharcoalBrush" Color="{StaticResource WorldCharcoal}" />
    <SolidColorBrush x:Key="WorldSmokeBrush" Color="{StaticResource WorldSmoke}" />
    <SolidColorBrush x:Key="WorldSilverBrush" Color="{StaticResource WorldSilver}" />
    <SolidColorBrush x:Key="WorldWhiteBrush" Color="{StaticResource WorldWhite}" />
    <SolidColorBrush x:Key="WorldMutedBrush" Color="{StaticResource WorldMuted}" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{StaticResource GlassStroke}" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="{StaticResource GlassHighlight}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBright}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentHaloBrush" Color="{StaticResource AccentHalo}" />
    <SolidColorBrush x:Key="EnabledSurfaceBrush" Color="{StaticResource EnabledSurface}" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="{StaticResource SelectedSurface}" />
    <SolidColorBrush x:Key="GlassHoverSurfaceBrush" Color="{StaticResource GlassHoverSurface}" />
    <SolidColorBrush x:Key="GlassHoverStrokeBrush" Color="{StaticResource GlassHoverStroke}" />
    <RadialGradientBrush x:Key="AtmosphereGlow" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource AtmosphereCore}" Offset="0" />
        <GradientStop Color="#007ADCF2" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="WorldBackdrop" StartPoint="0,0" EndPoint="1,1">
        <!-- High-opacity grayscale veil lets Windows composition show softly through when available. -->
        <GradientStop Color="#F5050A0D" Offset="0" />
        <GradientStop Color="#F50B1720" Offset="0.5" />
        <GradientStop Color="#F9010609" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassPanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EF0D1A21" Offset="0" />
        <GradientStop Color="#E9061015" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassTile" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D414242B" Offset="0" />
        <GradientStop Color="#C2081117" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="PanelShadow" Color="#FF7ADCF2" BlurRadius="34" ShadowDepth="5" Opacity="0.2" />
    <DropShadowEffect x:Key="GlassHoverGlow" Color="#FF7ADCF2" BlurRadius="20" ShadowDepth="0" Opacity="0.36" />
    <DropShadowEffect x:Key="NavGlow" Color="#FF7ADCF2" BlurRadius="14" ShadowDepth="0" Opacity="0.72" />
    <DropShadowEffect x:Key="ModuleHalo" Color="#FF7ADCF2" BlurRadius="23" ShadowDepth="0" Opacity="0.58" />
    <DropShadowEffect x:Key="SelectedHalo" Color="#FF7ADCF2" BlurRadius="32" ShadowDepth="0" Opacity="0.9" />
    <DropShadowEffect x:Key="TextGlow" Color="#FF7ADCF2" BlurRadius="13" ShadowDepth="0" Opacity="0.86" />

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorldWhiteBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorldSilverBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource WorldMutedBrush}" />
    </Style>
</ResourceDictionary>
