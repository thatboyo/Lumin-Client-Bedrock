<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Synth palette: deep violet glass, neon rose light, and a restrained cyan counterpoint. -->
    <Color x:Key="WorldBlack">#FF08050F</Color>
    <Color x:Key="WorldCharcoal">#FF151020</Color>
    <Color x:Key="WorldSmoke">#E61E172B</Color>
    <Color x:Key="WorldSilver">#FFD0C2D8</Color>
    <Color x:Key="WorldWhite">#FFFFF4FF</Color>
    <Color x:Key="WorldMuted">#FF90839D</Color>
    <Color x:Key="GlassStroke">#33EBD4FF</Color>
    <Color x:Key="GlassHighlight">#18F5B4EA</Color>
    <Color x:Key="AccentBright">#FFFFE8FB</Color>
    <Color x:Key="AccentPrimary">#FFFF6BD6</Color>
    <Color x:Key="AccentHalo">#88FF6BD6</Color>
    <Color x:Key="EnabledSurface">#C51F1729</Color>
    <Color x:Key="SelectedSurface">#E0281A35</Color>
    <Color x:Key="AtmosphereCore">#40FF6BD6</Color>
    <Color x:Key="GlassHoverSurface">#D1261833</Color>
    <Color x:Key="GlassHoverStroke">#77FF9FF0</Color>
    <Color x:Key="StatusAmber">#FFE7BD78</Color>
    <Color x:Key="StatusRed">#FFE68B91</Color>

    <SolidColorBrush x:Key="WorldBlackBrush" Color="{StaticResource WorldBlack}" />
    <SolidColorBrush x:Key="WorldCharcoalBrush" Color="{StaticResource WorldCharcoal}" />
    <SolidColorBrush x:Key="WorldSmokeBrush" Color="{StaticResource WorldSmoke}" />
    <SolidColorBrush x:Key="WorldSilverBrush" Color="{StaticResource WorldSilver}" />
    <SolidColorBrush x:Key="WorldWhiteBrush" Color="{StaticResource WorldWhite}" />
    <SolidColorBrush x:Key="WorldMutedBrush" Color="{StaticResource WorldMuted}" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{StaticResource GlassStroke}" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="{StaticResource GlassHighlight}" />
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBright}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentHaloBrush" Color="{StaticResource AccentHalo}" />
    <SolidColorBrush x:Key="EnabledSurfaceBrush" Color="{StaticResource EnabledSurface}" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="{StaticResource SelectedSurface}" />
    <SolidColorBrush x:Key="GlassHoverSurfaceBrush" Color="{StaticResource GlassHoverSurface}" />
    <SolidColorBrush x:Key="GlassHoverStrokeBrush" Color="{StaticResource GlassHoverStroke}" />
    <RadialGradientBrush x:Key="AtmosphereGlow" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource AtmosphereCore}" Offset="0" />
        <GradientStop Color="#00FF6BD6" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="WorldBackdrop" StartPoint="0,0" EndPoint="1,1">
        <!-- High-opacity grayscale veil lets Windows composition show softly through when available. -->
        <GradientStop Color="#F508050F" Offset="0" />
        <GradientStop Color="#F5120C20" Offset="0.5" />
        <GradientStop Color="#F904020A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassPanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EF20172C" Offset="0" />
        <GradientStop Color="#E90D0918" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassTile" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D421172E" Offset="0" />
        <GradientStop Color="#C20E0919" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="PanelShadow" Color="#FFFF6BD6" BlurRadius="34" ShadowDepth="5" Opacity="0.2" />
    <DropShadowEffect x:Key="GlassHoverGlow" Color="#FFFF6BD6" BlurRadius="20" ShadowDepth="0" Opacity="0.36" />
    <DropShadowEffect x:Key="NavGlow" Color="#FFFF6BD6" BlurRadius="14" ShadowDepth="0" Opacity="0.72" />
    <DropShadowEffect x:Key="ModuleHalo" Color="#FFFF6BD6" BlurRadius="23" ShadowDepth="0" Opacity="0.58" />
    <DropShadowEffect x:Key="SelectedHalo" Color="#FFFF6BD6" BlurRadius="32" ShadowDepth="0" Opacity="0.9" />
    <DropShadowEffect x:Key="TextGlow" Color="#FFFF6BD6" BlurRadius="13" ShadowDepth="0" Opacity="0.86" />

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorldWhiteBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WorldSilverBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource WorldMutedBrush}" />
    </Style>
</ResourceDictionary>
