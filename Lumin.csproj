<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lumin</AssemblyName>
    <RootNamespace>Lumin</RootNamespace>
    <ApplicationIcon>Assets\Lumin.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Resource Include="Assets\Lumin.png" />
    <Resource Include="Assets\Lumin-Transparent.png" />
    <Resource Include="Assets\Lumin-AppIcon.png" />
  </ItemGroup>
</Project>
